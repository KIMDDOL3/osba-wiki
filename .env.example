# ---- Obsidian vault ----
# Absolute path to your Obsidian vault. Falls back to ~/Documents/wiki.
OBSIDIAN_VAULT_PATH=
WIKI_PATH=

# ---- PostgreSQL + pgvector ----
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=
PGPASSWORD=
PGDATABASE=obsidian_rag

# ---- LLM API keys (all optional; pipelines degrade gracefully without them) ----
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=
OPENAI_MODEL=

# ---- Embeddings (optional overrides) ----
PGVECTOR_EMBED_PROVIDER=
PGVECTOR_EMBED_MODEL=

# ---- Neo4j (optional graph expansion) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- Notifications (optional) ----
# Discord bot token is read from DISCORD_BOT_TOKEN; channel id from:
DISCORD_BOT_TOKEN=
DISCORD_MAIN_CHANNEL_ID=

# ---- Notion sync (scripts/notion-sync) ----
# Either set NOTION_TOKEN here or put it one line in scripts/notion-sync/token
NOTION_TOKEN=

# ---- Local Whisper (meeting_to_minutes.py) ----
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
